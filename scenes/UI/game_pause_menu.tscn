[gd_scene load_steps=2 format=3]
[ext_resource type="Script" path="res://scenes/UI/pause.gd" id="1"]

[node name="PauseMenu" type="Control"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.03, 0.04, 0.06, 0.85)

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -280.0
offset_top = -390.0
offset_right = 280.0
offset_bottom = 390.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 18

[node name="paused" type="Label" parent="VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Paused"
horizontal_alignment = 1

[node name="resume" type="Button" parent="VBoxContainer"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
text = "Resume"

[node name="restart" type="Button" parent="VBoxContainer"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
text = "Restart Area"

[node name="quit" type="Button" parent="VBoxContainer"]
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
text = "Return to Title"

[node name="CameraSettings" type="VBoxContainer" parent="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="VBoxContainer/CameraSettings"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Camera"

[node name="AutoReset" type="CheckButton" parent="VBoxContainer/CameraSettings"]
layout_mode = 2
button_pressed = true
text = "Auto-center when mouse stops moving"

[node name="ResetRow" type="HBoxContainer" parent="VBoxContainer/CameraSettings"]
layout_mode = 2

[node name="Label" type="Label" parent="VBoxContainer/CameraSettings/ResetRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Idle delay"

[node name="Delay" type="SpinBox" parent="VBoxContainer/CameraSettings/ResetRow"]
custom_minimum_size = Vector2(160, 40)
layout_mode = 2
min_value = 0.5
max_value = 30.0
step = 0.1
value = 3.0
suffix = "s"

[node name="DeadzoneRow" type="HBoxContainer" parent="VBoxContainer/CameraSettings"]
layout_mode = 2

[node name="Label" type="Label" parent="VBoxContainer/CameraSettings/DeadzoneRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Mouse deadzone"

[node name="Deadzone" type="SpinBox" parent="VBoxContainer/CameraSettings/DeadzoneRow"]
custom_minimum_size = Vector2(160, 40)
layout_mode = 2
max_value = 90.0
step = 1.0
value = 18.0
suffix = "%"

[node name="Hint" type="Label" parent="VBoxContainer/CameraSettings"]
layout_mode = 2
text = "Middle click: lock / unlock
Hold middle + move: select target; release: confirm"
theme_override_font_sizes/font_size = 18

[node name="Status" type="Label" parent="VBoxContainer/CameraSettings"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = ""

[node name="EnemyDebug" type="VBoxContainer" parent="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="VBoxContainer/EnemyDebug"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Debug - Enemies"

[node name="DisableAI" type="CheckButton" parent="VBoxContainer/EnemyDebug"]
layout_mode = 2
text = "Disable enemy AI"
tooltip_text = "Stop current enemies from moving or attacking. Gravity and receiving hits remain active."

[node name="Immortal" type="CheckButton" parent="VBoxContainer/EnemyDebug"]
layout_mode = 2
text = "Invincible enemies"
tooltip_text = "Hits and stun still work; enemy HP does not decrease. Session only."

[node name="fade_trans" type="ColorRect" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0, 1)

[connection signal="pressed" from="VBoxContainer/resume" to="." method="_on_resume_pressed"]
[connection signal="pressed" from="VBoxContainer/restart" to="." method="_on_restart_pressed"]
[connection signal="pressed" from="VBoxContainer/quit" to="." method="_on_quit_pressed"]
