[sub_resource type="GDScript" id="GDScript_jn4p2"]
script/source = "extends CharacterBody2D
@onready var anim = $AnimatedSprite2D
@onready var weapon_pivot = $WeaponPivot
const SPEED = 300.0
const JUMP_VELOCITY = -600.0
const NPC_SLIDE_OFF_SPEED = 400

signal player_attacked

var can_move: bool = true
var is_locked: bool = false
var is_resting: bool = false
var is_on_npc_head: bool = false
var is_guarding : bool = false
var npc_head_position: Vector2 = Vector2.ZERO
var _position_before_rest: Vector2 = Vector2.ZERO
var facing_direction : int = 0

func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed(\"attack\"):
		player_attacked.emit()
	elif event.is_action_type() and event.is_action(\"guard and deflect\"):
		if event.is_pressed():
			is_guarding = true
			can_move = false
		elif event.is_released():
			is_guarding = false
			can_move = true

func take_damage():
	print(\"player took damage\")

func enter_rest(_world_position: Vector2, face_left: bool) -> void:
	_position_before_rest = global_position
	is_resting = true
	is_locked = true
	can_move = false
	velocity = Vector2.ZERO
	anim.flip_h = face_left
	anim.play(\"idle\")

func exit_rest() -> void:
	is_resting = false
	is_locked = false
	can_move = true
	velocity = Vector2.ZERO
	global_position = _position_before_rest
	snap_feet_to_floor()

func snap_feet_to_floor(max_drop: float = 96.0) -> void:
	var col := $CollisionShape2D as CollisionShape2D
	if col == null or col.shape == null:
		return
	var half_h := _capsule_half_height(col)
	var feet := Vector2(col.global_position.x, col.global_position.y + half_h)
	var space := get_world_2d().direct_space_state
	var query := PhysicsRayQueryParameters2D.create(
		feet + Vector2(0, -4.0),
		feet + Vector2(0, max_drop)
	)
	query.collision_mask = collision_mask
	query.exclude = [get_rid()]
	var hit := space.intersect_ray(query)
	if hit.is_empty():
		return
	global_position.y += hit.position.y - feet.y

func _capsule_half_height(col: CollisionShape2D) -> float:
	var capsule := col.shape as CapsuleShape2D
	if capsule == null:
		return 32.0
	var scale_y := col.global_transform.get_scale().y
	return capsule.height * 0.5 * scale_y

func _physics_process(delta: float) -> void:
	if is_resting:
		velocity = Vector2.ZERO
		return
	if is_locked or can_move == false:
		velocity.x = 0
		move_and_slide()
		return
	if not is_on_floor():
		velocity += get_gravity() * delta
	#Moving	
	var direction = Input.get_axis(\"move_left\", \"move_right\")
		
	if is_on_npc_head:
		if global_position.x > npc_head_position.x:
			velocity.x = NPC_SLIDE_OFF_SPEED
		else:
			velocity.x = -NPC_SLIDE_OFF_SPEED
	else:
		if direction:
			weapon_pivot.scale.x = direction
			if is_on_floor():
				anim.play(\"walking\")
			velocity.x = direction * SPEED
			anim.flip_h = direction < 0
			facing_direction = -1 if (direction < 0) else 1
		else:
			if is_on_floor():
				anim.play(\"idle\")
			velocity.x = move_toward(velocity.x, 0, SPEED)

	if Input.is_action_just_pressed(\"jump\") and is_on_floor():
		velocity.y = JUMP_VELOCITY

	# Single move_and_slide per frame: strip velocity into the wall without killing vertical speed.
	if is_on_wall() and not is_on_floor():
		var wall_normal := get_wall_normal()
		if velocity.dot(wall_normal) < 0.0:
			velocity = velocity.slide(wall_normal)

	move_and_slide()

func SET_ON_NPC_HEAD(is_on: bool, head_pos: Vector2 = Vector2.ZERO):
	is_on_npc_head = is_on
	npc_head_position = head_pos
"

